# Copy to .env and fill in real values. Never commit .env.

FLASK_PORT=4000
JWT_SECRET=replace_with_a_long_random_string
DB_PATH=./data/wsc.sqlite

# --- Alpaca Broker API ---
# Broker API access is a partnership product, not a self-serve key.
# Apply here: https://alpaca.markets/broker
# Sandbox base URL while integrating: https://broker-api.sandbox.alpaca.markets
# Production base URL once approved: https://broker-api.alpaca.markets
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_BROKER_API_KEY=
ALPACA_BROKER_API_SECRET=

# --- Plaid (bank account linking for ACH funding) ---
# https://plaid.com/docs/  Requires a Plaid account approved for your use case.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
